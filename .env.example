# ===========================================
# Produkt Auto - Environment Variables Example
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!

# Site URL (used for canonical URLs, sitemap, robots)
# --------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://produktauto.hr

# Sanity CMS Configuration
# ------------------------
# Get these from https://www.sanity.io/manage after creating a project
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Contact Form Email Configuration
# --------------------------------
# Email address that receives contact form submissions
CONTACT_EMAIL=your-email@example.com

# Email Service API Keys (choose one)
# -----------------------------------
# Option 1: Resend (https://resend.com) - Recommended
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Option 2: SendGrid (https://sendgrid.com)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxx

# ===========================================
# Note: Only one email service is needed.
# If both are set, Resend takes priority.
# In development without API keys, emails
# are logged to console.
# ===========================================
