# ===========================================
# Produkt Auto - Environment Variables Example
# ===========================================
# Copy this file to .env.local for local development.
# On Vercel, set the same keys in Project Settings → Environment Variables.
#
# Never commit real secrets (API keys, passwords) to git.

# Site URL (used for canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://produktauto.com

# Database (Custom CMS)
# For Vercel Postgres, use the variables Vercel provides via the integration.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST:5432/DB?pgbouncer=true&connection_limit=1

# Optional but recommended for migrations (non-pooling):
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST:5432/DB

# Custom CMS (HR-only)
CMS_ADMIN_USERNAME=your_admin_username_here
CMS_ADMIN_PASSWORD=your_admin_password_here
CMS_SESSION_SECRET=your_session_secret_here

# Contact Form
CONTACT_EMAIL=your_contact_email_here

# Email service API keys (choose one)
# Resend (recommended): https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# SendGrid (optional): https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
